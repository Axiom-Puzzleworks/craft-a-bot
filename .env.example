# Craft A Bot — environment variables
#
# There are none at runtime: the app is local-first with no backend, and the
# user's API key lives in their browser's localStorage (06-LLM-PROVIDERS.md §6),
# never in a file and never in this repo.
#
# The single variable below is for the live OpenAI smoke test, which is run by
# hand and never in CI (10-CODING-STANDARDS.md §5):
#
#     OPENAI_API_KEY=sk-... npm run smoke:openai
#
# Copy this file to `.env` if you like — `.env` is gitignored. Prefer a
# separate, spending-capped key.
OPENAI_API_KEY=

# The headless harness (`npm run craftabot`, WP37) reads credentials only from
# CRAFTABOT_CREDENTIAL_<ID>, where <ID> is the provider or brick credential id
# upper-cased — never from a file it wrote, never printed. For example:
#
#     CRAFTABOT_CREDENTIAL_OPENAI=sk-... npm run craftabot -- run --kit bot.craftabot.json --provider openai
#
# The scripted brains (the default) need no key at all.
CRAFTABOT_CREDENTIAL_OPENAI=
CRAFTABOT_CREDENTIAL_GEAP=
