{
	"name": "@craftabot/core",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		},
		"./testing/contract": {
			"types": "./dist/testing/contract.d.ts",
			"default": "./dist/testing/contract.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run --coverage",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
