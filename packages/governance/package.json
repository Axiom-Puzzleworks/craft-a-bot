{
	"name": "@craftabot/governance",
	"version": "1.0.0-rc.1",
	"description": "Guardrail mechanisms for agent loops: budgets, blocklists, a loop-breaker, an approval gate, a policy-card compiler, a shell for hosted guard services, a policy-decision-point input document, and the governance reports — over @craftabot/core's contracts and nothing else.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Axiom-Puzzleworks/craft-a-bot.git",
		"directory": "packages/governance"
	},
	"keywords": [
		"agents",
		"guardrails",
		"ai-safety",
		"policy-as-code",
		"governance"
	],
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./reports": {
			"types": "./dist/reports/index.d.ts",
			"default": "./dist/reports/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run --coverage",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@craftabot/core": "*",
		"zod": "^4.4.3"
	}
}
