{
	"name": "@craftabot/gate",
	"private": true,
	"version": "0.1.0",
	"description": "The Gate: a Craft A Bot stack over the OpenAI chat-completions wire, in front of any agent (WP127, 107-THE-GATE.md). A reference implementation, Node only.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./presets": {
			"types": "./dist/presets.d.ts",
			"default": "./dist/presets.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run --coverage",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@craftabot/core": "*",
		"@craftabot/governance": "*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@craftabot/pack-fs-bank": "*",
		"@craftabot/pack-starter": "*",
		"@types/node": "^24.10.1"
	}
}
