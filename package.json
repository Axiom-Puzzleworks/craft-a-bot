{
	"name": "craft-a-bot",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "npm@11.19.0",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/packs/*",
		"examples/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"check": "turbo run check",
		"lint": "prettier --check . && eslint . && turbo run check",
		"format": "prettier --write .",
		"e2e": "npm run e2e --workspace=apps/workbench",
		"demo": "npm run build && echo \"Demo built at apps/workbench/build \u00e2\u20ac\u201d serve it with any static host, or npm run preview\"",
		"preview": "npm run preview --workspace=apps/workbench",
		"budget": "node scripts/bundle-budget.mjs",
		"smoke:openai": "npm run smoke --workspace=@craftabot/pack-openai",
		"smoke:geap": "npm run smoke --workspace=@craftabot/pack-geap",
		"smoke:harness": "npm run build --workspace=packages/harness && node --env-file-if-exists=.env packages/harness/dist/main.js run --kit packages/harness/fixtures/snackbot.craftabot.json --provider openai --max-ticks 6 --out ./runs",
		"evals": "npm run craftabot -- campaign --matrix scripted --out packages/evals/baselines",
		"craftabot": "node packages/harness/dist/main.js",
		"example:governance": "node examples/plain-node-agent/dist/main.js",
		"check:governance-pack": "node scripts/check-governance-pack.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"turbo": "^2.10.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.10"
	}
}
