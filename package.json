{
	"name": "craft-a-bot",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "npm@11.19.0",
	"engines": {
		"node": ">=20"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/packs/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"check": "turbo run check",
		"lint": "prettier --check . && eslint . && turbo run check",
		"format": "prettier --write .",
		"e2e": "npm run e2e --workspace=apps/workbench",
		"demo": "npm run dev --workspace=apps/workbench",
		"preview": "npm run preview --workspace=apps/workbench"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"turbo": "^2.10.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.10"
	}
}
