node_modules

# Output
.output
.vercel
.netlify
.wrangler
.svelte-kit
build
dist

# Turborepo
.turbo

# Test artefacts
coverage
playwright-report
test-results

# The harness's default output directory (`craftabot run --out ./runs`) —
# runs are evidence a person keeps deliberately, never something to commit.
runs

# OS
.DS_Store
Thumbs.db

# Env — every .env variant is ignored except the committed template.
# `.env.test` was previously un-ignored too; nothing referenced it, and on a
# public repo an un-ignored filename that invites a real key in is a trap.
.env
.env.*
!.env.example

# The Python example's own venv (`npm run example:python` makes it).
examples/python-reader/.venv

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Claude Code — personal, local-only settings (permissions, etc). launch.json
# stays tracked: it's shared dev-server config any session's preview tooling
# can use, not personal.
.claude/settings.local.json
campaign-out/

# TypeScript incremental build info (a `tsc -b` run inside a package writes one)
*.tsbuildinfo

# The Sparks lease (`craftabot spark up` remembers what the units were doing; 99-DGX-SPARK.md §9)
.craftabot/

# Scratch space for scripts/live-record.mjs (WP168)
.live-work/
