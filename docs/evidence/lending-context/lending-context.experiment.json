{
	"schemaVersion": 1,
	"id": "lending-context",
	"title": "The ontology on the loan book",
	"hypothesis": "Giving the bot the ontology raises rule agreement and explanation faithfulness, with or without the stack.",
	"controls": [
		"fs-lending/control-map/explanation"
	],
	"obligations": [
		"fca:cd:understanding",
		"ukgdpr:data-minimisation"
	],
	"design": {
		"template": {
			"scenarios": [],
			"source": {
				"kind": "book",
				"workflowId": "fs-lending/lending",
				"population": {
					"seed": 1,
					"size": 10000
				}
			},
			"builds": [
				{
					"id": "bot",
					"base": {
						"kind": "starter-default"
					},
					"overrides": {
						"senses": [
							"fs-lending/the-lending-desk/application",
							"fs-lending/the-lending-desk/bureau",
							"fs-lending/the-lending-desk/affordability-worksheet",
							"fs-lending/the-lending-desk/conversation"
						],
						"actions": [
							"fs-lending/the-lending-desk/say",
							"fs-lending/the-lending-desk/verify-identity",
							"fs-lending/the-lending-desk/assess-affordability",
							"fs-lending/the-lending-desk/request-document",
							"fs-lending/the-lending-desk/decide",
							"fs-lending/the-lending-desk/explain-decision",
							"fs-lending/the-lending-desk/disburse",
							"fs-lending/the-lending-desk/log-appeal"
						],
						"reviewer": "fs-bank/reviewer/case-handler"
					}
				}
			],
			"guards": [
				{
					"id": "none",
					"fit": []
				},
				{
					"id": "policy-cards",
					"fit": [
						{
							"slot": "safety",
							"kind": "starter/safety",
							"configVersion": 2,
							"config": {
								"maxTicks": 20,
								"blockedActions": [],
								"approval": "off",
								"policyCards": [
									"fs-lending/policy/no-decision-before-affordability",
									"fs-lending/policy/refer-when-the-rules-say-refer",
									"fs-lending/policy/reasons-are-real",
									"fs-lending/policy/disbursement-is-four-eyes",
									"fs-lending/policy/cohort-blind",
									"fs-bank/policy/fallback"
								]
							}
						}
					]
				}
			],
			"brains": [
				{
					"id": "scripted-noisy",
					"tier": "scripted-noisy"
				},
				{
					"id": "fallible",
					"tier": "fallible",
					"errorModel": "fs-lending/error/decision"
				}
			],
			"assertionCards": [],
			"sinks": [],
			"evaluators": [
				{
					"id": "fs-lending/decision-matches-rules"
				},
				{
					"id": "fs-lending/explanation-faithful"
				}
			]
		},
		"factors": [
			{
				"axis": "context",
				"levels": [
					"case-file",
					"ontology"
				]
			},
			{
				"axis": "guard",
				"levels": [
					"none",
					"policy-cards"
				]
			},
			{
				"axis": "brain",
				"levels": [
					"scripted-noisy",
					"fallible"
				]
			}
		],
		"baseline": {
			"context": "case-file",
			"guard": "none",
			"brain": "scripted-noisy"
		},
		"metrics": [
			{
				"kind": "evaluator-pass-rate",
				"id": "agreement",
				"direction": "higher-is-better",
				"evaluatorId": "fs-lending/decision-matches-rules"
			},
			{
				"kind": "evaluator-pass-rate",
				"id": "faithful",
				"direction": "higher-is-better",
				"evaluatorId": "fs-lending/explanation-faithful"
			}
		],
		"seeds": [
			1
		],
		"replicates": 1,
		"confidence": 0.95,
		"minimumDetectableEffect": 0.05
	},
	"campaigns": [
		"lending-context--brain=scripted-noisy--context=case-file--guard=none",
		"lending-context--brain=fallible--context=case-file--guard=none",
		"lending-context--brain=scripted-noisy--context=case-file--guard=policy-cards",
		"lending-context--brain=fallible--context=case-file--guard=policy-cards",
		"lending-context--brain=scripted-noisy--context=ontology--guard=none",
		"lending-context--brain=fallible--context=ontology--guard=none",
		"lending-context--brain=scripted-noisy--context=ontology--guard=policy-cards",
		"lending-context--brain=fallible--context=ontology--guard=policy-cards"
	]
}
