{
	"schemaVersion": 1,
	"id": "servicing-readers",
	"title": "The servicing readers on the held-out corpus: the bank’s regex against Jev as first asked (q1), Jev with the guide’s rules in its questions (q2), and q2 behind a confidence gate",
	"hypothesis": "On calls no question was fitted to, stating the labelling guide’s rules in the questions (q2) reduces Jev’s false needs without losing any disclosed one, and the steer check sends callers who dictate the label to a person.",
	"controls": [],
	"obligations": [
		"fca:fg21-1:vulnerability",
		"fca:cd:support"
	],
	"design": {
		"template": {
			"scenarios": [],
			"source": {
				"kind": "book",
				"workflowId": "typesafe/servicing-jev-v3",
				"population": {
					"seed": 1,
					"size": 120
				},
				"corpus": "fs-servicing/corpus/requests-v3",
				"regression": true
			},
			"builds": [
				{
					"id": "desk",
					"base": {
						"kind": "starter-default"
					},
					"overrides": {
						"senses": [
							"fs-servicing/the-servicing-desk/request",
							"fs-servicing/the-servicing-desk/classification",
							"fs-servicing/the-servicing-desk/file",
							"fs-servicing/the-servicing-desk/conversation"
						],
						"actions": [
							"fs-servicing/the-servicing-desk/say",
							"fs-servicing/the-servicing-desk/identify-caller",
							"fs-servicing/the-servicing-desk/classify",
							"fs-servicing/the-servicing-desk/update-address",
							"fs-servicing/the-servicing-desk/reissue-card",
							"fs-servicing/the-servicing-desk/grant-third-party-access",
							"fs-servicing/the-servicing-desk/record-support-need",
							"fs-servicing/the-servicing-desk/close-account"
						]
					}
				}
			],
			"guards": [
				{
					"id": "none",
					"fit": []
				}
			],
			"brains": [
				{
					"id": "scripted-optimal",
					"tier": "scripted-optimal"
				}
			],
			"assertionCards": [],
			"sinks": [],
			"evaluators": [
				{
					"id": "fs-servicing/classified-correctly"
				},
				{
					"id": "typesafe/need-matches-label"
				},
				{
					"id": "typesafe/need-detected"
				},
				{
					"id": "fs-servicing/disclosure-recorded"
				},
				{
					"id": "fs-servicing/needs-met"
				}
			]
		},
		"factors": [
			{
				"axis": "executors",
				"levels": [
					"regex",
					"jev",
					"jev-q2",
					"jev-q2-gate-0.80",
					"jev-q2-gate-0.90"
				]
			}
		],
		"baseline": {
			"executors": "regex"
		},
		"metrics": [
			{
				"kind": "evaluator-pass-rate",
				"id": "request-read-right",
				"direction": "higher-is-better",
				"evaluatorId": "fs-servicing/classified-correctly"
			},
			{
				"kind": "evaluator-pass-rate",
				"id": "need-read-right",
				"direction": "higher-is-better",
				"evaluatorId": "typesafe/need-matches-label"
			},
			{
				"kind": "evaluator-pass-rate",
				"id": "need-detected",
				"direction": "higher-is-better",
				"evaluatorId": "typesafe/need-detected"
			},
			{
				"kind": "evaluator-pass-rate",
				"id": "disclosure-recorded",
				"direction": "higher-is-better",
				"evaluatorId": "fs-servicing/disclosure-recorded"
			},
			{
				"kind": "evaluator-pass-rate",
				"id": "needs-met",
				"direction": "higher-is-better",
				"evaluatorId": "fs-servicing/needs-met"
			},
			{
				"kind": "cost",
				"id": "touches",
				"direction": "lower-is-better",
				"of": "touches"
			}
		],
		"seeds": [
			1
		],
		"replicates": 1,
		"confidence": 0.95,
		"minimumDetectableEffect": 0.05
	},
	"campaigns": [
		"servicing-readers--executors=regex",
		"servicing-readers--executors=jev",
		"servicing-readers--executors=jev-q2",
		"servicing-readers--executors=jev-q2-gate-0-80",
		"servicing-readers--executors=jev-q2-gate-0-90"
	]
}
