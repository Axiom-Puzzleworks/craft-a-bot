{
	"schemaVersion": 1,
	"id": "advice-contract-live",
	"title": "The relational context on the advice-request register — with the 35B on the DGX Sparks as the brain",
	"hypothesis": "The relational context lowers unsuitable recommendations and raises data-minimisation findings against the case file alone. Here the decisions are made by a live model, `dgx-spark/quick-qwen` (Qwen3.6-35B-A3B-NVFP4 on the builder's DGX Sparks), at temperature 0 with a 2048-token reply limit, over a book of 600: a single sample, recorded once and replayed from its cassette. The design's scripted and fallible columns are `advice-context`. The factor is `replyContract`: what a reply with no tool call means at the journey's agent stages (plan 114 WP205); `none` is the desk as it was.",
	"controls": [
		"fs-advice/control-map/suitability",
		"fs-advice/control-map/minimisation-and-purpose"
	],
	"obligations": [
		"fca:cobs-9:suitability",
		"ukgdpr:data-minimisation"
	],
	"design": {
		"template": {
			"scenarios": [],
			"source": {
				"kind": "book",
				"workflowId": "fs-advice/advice",
				"population": {
					"seed": 1,
					"size": 600
				}
			},
			"builds": [
				{
					"id": "bot",
					"base": {
						"kind": "starter-default"
					},
					"overrides": {
						"senses": [
							"fs-advice/the-advice-desk/conversation",
							"fs-advice/the-advice-desk/customer-record",
							"fs-advice/the-advice-desk/product-shelf"
						],
						"actions": [
							"fs-advice/the-advice-desk/say",
							"fs-advice/the-advice-desk/ask-suitability-question",
							"fs-advice/the-advice-desk/run-fact-find",
							"fs-advice/the-advice-desk/check-suitability",
							"fs-advice/the-advice-desk/record-customer-fact",
							"fs-advice/the-advice-desk/recommend-product",
							"fs-advice/the-advice-desk/refer-to-adviser",
							"fs-advice/the-advice-desk/execute-investment"
						],
						"maxTokens": 2048,
						"configuration": "bot-everywhere",
						"reviewer": "fs-bank/reviewer/case-handler"
					}
				}
			],
			"guards": [
				{
					"id": "none",
					"fit": []
				}
			],
			"brains": [
				{
					"id": "live",
					"tier": "live",
					"cartridgeId": "dgx-spark/quick-qwen",
					"cassette": "docs/evidence/live-contract/advice-contract-live/advice-contract-live.provider-cassette.json"
				}
			],
			"assertionCards": [],
			"sinks": [],
			"evaluators": [
				{
					"id": "fs-advice/recommendation-suitable"
				},
				{
					"id": "fs-advice/data-minimised"
				}
			],
			"budget": {
				"maxLiveCells": 1000
			}
		},
		"factors": [
			{
				"axis": "context",
				"levels": [
					"case-file",
					"relational"
				]
			},
			{
				"axis": "override",
				"levels": [
					"none",
					"say",
					"retry-with-nudge"
				],
				"override": "replyContract"
			}
		],
		"baseline": {
			"context": "case-file",
			"executors": "bot-everywhere",
			"override": "none"
		},
		"metrics": [
			{
				"kind": "evaluator-pass-rate",
				"id": "suitable",
				"direction": "higher-is-better",
				"evaluatorId": "fs-advice/recommendation-suitable"
			},
			{
				"kind": "evaluator-pass-rate",
				"id": "minimised",
				"direction": "higher-is-better",
				"evaluatorId": "fs-advice/data-minimised"
			}
		],
		"seeds": [
			1
		],
		"replicates": 1,
		"trials": 2,
		"confidence": 0.95,
		"minimumDetectableEffect": 0.05
	},
	"campaigns": [
		"advice-contract-live--context=case-file--override=none",
		"advice-contract-live--context=case-file--override=say",
		"advice-contract-live--context=case-file--override=retry-with-nudge",
		"advice-contract-live--context=relational--override=none",
		"advice-contract-live--context=relational--override=say",
		"advice-contract-live--context=relational--override=retry-with-nudge"
	]
}
