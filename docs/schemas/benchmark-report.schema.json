{
	"$id": "https://craftabot.dev/schemas/benchmark-report.schema.json",
	"title": "Craft A Bot benchmark report",
	"description": "Every subject of a benchmark over the same adversarial rows (WP123, 106-BENCHMARK.md §6): how each answered (a stand-in, a cassette, live, local), precision and recall on attack ≠ none with their Wilson intervals, the rows by attack, target and surface, latency where recorded, a list price where cited, the rows each alone caught or missed, and a digest. Every row synthetic.",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "number",
			"const": 1
		},
		"id": {
			"type": "string",
			"minLength": 1
		},
		"benchmarkId": {
			"type": "string",
			"minLength": 1
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"ranAt": {
			"type": "string",
			"minLength": 1
		},
		"synthetic": {
			"type": "boolean",
			"const": true
		},
		"threshold": {
			"type": "number",
			"minimum": 0,
			"maximum": 1
		},
		"corpora": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"digest": {
						"type": "string",
						"pattern": "^[0-9a-f]{64}$"
					},
					"rows": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"attacks": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					}
				},
				"required": [
					"id",
					"digest",
					"rows",
					"attacks"
				]
			}
		},
		"subjects": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"kind": {
						"type": "string",
						"enum": [
							"service",
							"reader",
							"component"
						]
					},
					"name": {
						"type": "string",
						"minLength": 1
					},
					"componentId": {
						"type": "string",
						"minLength": 1
					},
					"mode": {
						"type": "string",
						"enum": [
							"stand-in",
							"cassette",
							"live",
							"local"
						]
					},
					"applicable": {
						"type": "boolean"
					},
					"reason": {
						"type": "string",
						"minLength": 1
					},
					"n": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"flagged": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"errors": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"confusion": {
						"type": "object",
						"properties": {
							"tp": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"fp": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"fn": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"tn": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							}
						},
						"required": [
							"tp",
							"fp",
							"fn",
							"tn"
						]
					},
					"precision": {
						"type": "object",
						"properties": {
							"value": {
								"anyOf": [
									{
										"type": "number",
										"minimum": 0,
										"maximum": 1
									},
									{
										"type": "null"
									}
								]
							},
							"interval": {
								"anyOf": [
									{
										"type": "array",
										"prefixItems": [
											{
												"type": "number"
											},
											{
												"type": "number"
											}
										]
									},
									{
										"type": "null"
									}
								]
							}
						},
						"required": [
							"value",
							"interval"
						]
					},
					"recall": {
						"type": "object",
						"properties": {
							"value": {
								"anyOf": [
									{
										"type": "number",
										"minimum": 0,
										"maximum": 1
									},
									{
										"type": "null"
									}
								]
							},
							"interval": {
								"anyOf": [
									{
										"type": "array",
										"prefixItems": [
											{
												"type": "number"
											},
											{
												"type": "number"
											}
										]
									},
									{
										"type": "null"
									}
								]
							}
						},
						"required": [
							"value",
							"interval"
						]
					},
					"falseAlarms": {
						"type": "object",
						"properties": {
							"value": {
								"anyOf": [
									{
										"type": "number",
										"minimum": 0,
										"maximum": 1
									},
									{
										"type": "null"
									}
								]
							},
							"interval": {
								"anyOf": [
									{
										"type": "array",
										"prefixItems": [
											{
												"type": "number"
											},
											{
												"type": "number"
											}
										]
									},
									{
										"type": "null"
									}
								]
							}
						},
						"required": [
							"value",
							"interval"
						]
					},
					"byAttack": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": "object",
							"properties": {
								"rows": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								},
								"flagged": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								}
							},
							"required": [
								"rows",
								"flagged"
							]
						}
					},
					"byTarget": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": "object",
							"properties": {
								"rows": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								},
								"flagged": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								}
							},
							"required": [
								"rows",
								"flagged"
							]
						}
					},
					"bySurface": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": "object",
							"properties": {
								"rows": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								},
								"flagged": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								}
							},
							"required": [
								"rows",
								"flagged"
							]
						}
					},
					"latency": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"p50": {
										"type": "number",
										"minimum": 0
									},
									"p95": {
										"type": "number",
										"minimum": 0
									}
								},
								"required": [
									"p50",
									"p95"
								]
							},
							{
								"type": "null"
							}
						]
					},
					"tokens": {
						"anyOf": [
							{
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							{
								"type": "null"
							}
						]
					},
					"listPriceUsd": {
						"anyOf": [
							{
								"type": "number",
								"minimum": 0
							},
							{
								"type": "null"
							}
						]
					},
					"caughtAlone": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"missedAlone": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				},
				"required": [
					"id",
					"kind",
					"name",
					"mode",
					"applicable",
					"n",
					"flagged",
					"errors",
					"confusion",
					"precision",
					"recall",
					"falseAlarms",
					"byAttack",
					"byTarget",
					"bySurface",
					"latency",
					"tokens",
					"listPriceUsd",
					"caughtAlone",
					"missedAlone"
				]
			}
		},
		"digest": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		}
	},
	"required": [
		"schemaVersion",
		"id",
		"benchmarkId",
		"name",
		"ranAt",
		"synthetic",
		"threshold",
		"corpora",
		"subjects",
		"digest"
	]
}
