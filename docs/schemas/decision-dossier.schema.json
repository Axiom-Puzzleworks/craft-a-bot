{
	"$id": "https://craftabot.dev/schemas/decision-dossier.schema.json",
	"title": "Craft A Bot decision dossier (v1)",
	"description": "One claim about a model making one kind of decision: eight measures — accuracy, reliability, robustness, faithfulness, fairness, oversight, cost, harm — each with its value, interval, source and a threshold, a verdict on each (met, not met, not shown) and one for the dossier; a digest (plan 114 WP214).",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "number",
			"const": 1
		},
		"id": {
			"type": "string",
			"minLength": 1
		},
		"subject": {
			"type": "string",
			"minLength": 1
		},
		"decisionKind": {
			"type": "string",
			"minLength": 1
		},
		"model": {
			"type": "string",
			"minLength": 1
		},
		"recordedOn": {
			"type": "string"
		},
		"generatedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
		},
		"measures": {
			"minItems": 8,
			"maxItems": 8,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"enum": [
							"accuracy",
							"reliability",
							"robustness",
							"faithfulness",
							"fairness",
							"oversight",
							"cost",
							"harm"
						]
					},
					"label": {
						"type": "string",
						"minLength": 1
					},
					"value": {
						"type": "number"
					},
					"interval": {
						"type": "array",
						"prefixItems": [
							{
								"type": "number"
							},
							{
								"type": "number"
							}
						]
					},
					"n": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"unit": {
						"type": "string",
						"enum": [
							"rate",
							"pounds",
							"difference"
						]
					},
					"threshold": {
						"type": "object",
						"properties": {
							"kind": {
								"type": "string",
								"enum": [
									"at-least",
									"at-most"
								]
							},
							"value": {
								"type": "number"
							}
						},
						"required": [
							"kind",
							"value"
						]
					},
					"verdict": {
						"type": "string",
						"enum": [
							"met",
							"not-met",
							"not-shown"
						]
					},
					"source": {
						"type": "object",
						"properties": {
							"resultId": {
								"type": "string",
								"minLength": 1
							},
							"experimentId": {
								"type": "string",
								"minLength": 1
							},
							"metricId": {
								"type": "string",
								"minLength": 1
							},
							"tier": {
								"type": "string"
							}
						},
						"required": [
							"resultId",
							"experimentId",
							"metricId"
						]
					},
					"note": {
						"type": "string"
					}
				},
				"required": [
					"id",
					"label",
					"unit",
					"threshold",
					"verdict",
					"note"
				]
			}
		},
		"verdict": {
			"type": "string",
			"enum": [
				"fit",
				"not-fit",
				"not-shown"
			]
		},
		"summary": {
			"type": "string"
		},
		"digest": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		}
	},
	"required": [
		"schemaVersion",
		"id",
		"subject",
		"decisionKind",
		"model",
		"generatedAt",
		"measures",
		"verdict",
		"summary",
		"digest"
	]
}
