{
	"$id": "https://craftabot.dev/schemas/bank-run.schema.json",
	"title": "Craft A Bot bank run (v1)",
	"description": "A day at the bank: the clock’s options, the desks’ assignments, the population digest, the counts, the incidents, every workflow run’s id and digest in arrival order, and a digest over those (71-THE-CLOCK.md §4).",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "number",
			"const": 1
		},
		"id": {
			"type": "string",
			"minLength": 1
		},
		"clock": {
			"type": "object",
			"properties": {
				"from": {
					"type": "string",
					"minLength": 1
				},
				"to": {
					"type": "string",
					"minLength": 1
				},
				"seed": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"acceleration": {
					"anyOf": [
						{
							"type": "number",
							"exclusiveMinimum": 0
						},
						{
							"type": "string",
							"const": "Infinity"
						}
					]
				},
				"rates": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "object",
						"properties": {
							"profile": {
								"minItems": 24,
								"maxItems": 24,
								"type": "array",
								"items": {
									"type": "number",
									"minimum": 0
								}
							},
							"scale": {
								"type": "number",
								"minimum": 0,
								"maximum": 1
							}
						},
						"required": [
							"profile",
							"scale"
						]
					}
				},
				"books": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"kind": {
								"type": "string",
								"enum": [
									"application",
									"alert",
									"complaint",
									"advice-request"
								]
							},
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"populationDigest": {
								"type": "string"
							}
						},
						"required": [
							"kind",
							"items"
						]
					}
				}
			},
			"required": [
				"from",
				"to",
				"seed",
				"acceleration",
				"books"
			]
		},
		"populationDigest": {
			"type": "string"
		},
		"desks": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"workflowId": {
						"type": "string",
						"minLength": 1
					},
					"kinds": {
						"minItems": 1,
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"application",
								"alert",
								"complaint",
								"advice-request"
							]
						}
					},
					"configuration": {
						"type": "string"
					},
					"knobs": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"anyOf": [
								{
									"type": "number"
								},
								{
									"type": "string"
								},
								{
									"type": "boolean"
								}
							]
						}
					},
					"context": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"level": {
								"type": "string",
								"enum": [
									"minimal",
									"case-file",
									"relational",
									"ontology"
								]
							},
							"include": {
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								}
							},
							"exclude": {
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								}
							},
							"ontology": {
								"type": "object",
								"properties": {
									"scope": {
										"type": "string",
										"enum": [
											"customer",
											"bank"
										]
									},
									"depth": {
										"type": "integer",
										"minimum": 0,
										"maximum": 4
									},
									"relations": {
										"type": "array",
										"items": {
											"type": "string",
											"minLength": 1
										}
									}
								},
								"required": [
									"scope",
									"depth"
								]
							},
							"delivery": {
								"default": [
									"sense"
								],
								"minItems": 1,
								"type": "array",
								"items": {
									"type": "string",
									"enum": [
										"brief",
										"sense",
										"line"
									]
								}
							},
							"budgetTokens": {
								"type": "integer",
								"exclusiveMinimum": 0,
								"maximum": 9007199254740991
							}
						},
						"required": [
							"id",
							"level"
						]
					},
					"concurrency": {
						"type": "integer",
						"exclusiveMinimum": 0,
						"maximum": 9007199254740991
					},
					"build": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"id",
					"workflowId",
					"kinds",
					"concurrency",
					"build"
				]
			}
		},
		"counts": {
			"type": "object",
			"properties": {
				"arrivals": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					}
				},
				"routed": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"unrouted": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"completed": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"stopped": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"handedOff": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"byDesk": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "object",
						"properties": {
							"worked": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"completed": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"stopped": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"handedOff": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							}
						},
						"required": [
							"worked",
							"completed",
							"stopped"
						]
					}
				}
			},
			"required": [
				"arrivals",
				"routed",
				"unrouted",
				"completed",
				"stopped",
				"byDesk"
			]
		},
		"incidents": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"runId": {
						"type": "string"
					},
					"itemId": {
						"type": "string"
					},
					"desk": {
						"type": "string"
					},
					"stageId": {
						"type": "string"
					},
					"status": {
						"type": "string"
					},
					"finding": {
						"type": "string"
					}
				},
				"required": [
					"runId",
					"itemId",
					"desk"
				]
			}
		},
		"runs": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"ordinal": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"itemId": {
						"type": "string"
					},
					"kind": {
						"type": "string",
						"enum": [
							"application",
							"alert",
							"complaint",
							"advice-request"
						]
					},
					"desk": {
						"type": "string"
					},
					"runId": {
						"type": "string"
					},
					"digest": {
						"type": "string"
					},
					"outcome": {
						"type": "string",
						"enum": [
							"completed",
							"stopped",
							"abandoned",
							"handed-off"
						]
					}
				},
				"required": [
					"ordinal",
					"itemId",
					"kind",
					"desk",
					"runId",
					"digest",
					"outcome"
				]
			}
		},
		"startedAt": {
			"type": "string"
		},
		"finishedAt": {
			"type": "string"
		},
		"wallMs": {
			"type": "number",
			"minimum": 0
		},
		"digest": {
			"type": "string",
			"minLength": 1
		}
	},
	"required": [
		"schemaVersion",
		"id",
		"clock",
		"desks",
		"counts",
		"incidents",
		"runs",
		"startedAt",
		"finishedAt",
		"digest"
	]
}
