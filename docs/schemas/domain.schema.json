{
	"$id": "https://craftabot.dev/schemas/domain.schema.json",
	"title": "Craft A Bot domain spec (v1)",
	"description": "What a domain pack is, as data: its world and journey packs, the obligation vocabulary, the decision rights with a ceiling and a source each, the calibration table, the ontology, the coverage matrix, the personas and the glossary (83-TARGET-DESIGN-V6.md §6.6.1).",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "number",
			"const": 1
		},
		"id": {
			"type": "string",
			"minLength": 1
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"jurisdiction": {
			"type": "string",
			"minLength": 1
		},
		"sector": {
			"type": "string",
			"minLength": 1
		},
		"packs": {
			"type": "object",
			"properties": {
				"world": {
					"type": "string",
					"minLength": 1
				},
				"journeys": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": [
				"world",
				"journeys"
			]
		},
		"obligations": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "string"
			}
		},
		"decisionRights": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"kind": {
						"type": "string",
						"minLength": 1
					},
					"ceiling": {
						"type": "integer",
						"minimum": 1,
						"maximum": 5
					},
					"why": {
						"type": "string",
						"minLength": 1
					},
					"source": {
						"type": "object",
						"properties": {
							"title": {
								"type": "string",
								"minLength": 1
							},
							"url": {
								"type": "string",
								"format": "uri"
							},
							"retrieved": {
								"type": "string",
								"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
							}
						},
						"required": [
							"title"
						]
					}
				},
				"required": [
					"kind",
					"ceiling",
					"why",
					"source"
				]
			}
		},
		"calibration": {
			"type": "string",
			"minLength": 1
		},
		"ontology": {
			"type": "object",
			"properties": {
				"classes": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"specialCategory": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": [
				"classes",
				"specialCategory"
			]
		},
		"journeys": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"workflowId": {
						"type": "string",
						"minLength": 1
					},
					"name": {
						"type": "string",
						"minLength": 1
					},
					"status": {
						"type": "string",
						"enum": [
							"shipped",
							"supporting",
							"out"
						]
					},
					"why": {
						"type": "string"
					}
				},
				"required": [
					"workflowId",
					"name",
					"status"
				]
			}
		},
		"personas": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"glossary": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "string"
			}
		}
	},
	"required": [
		"schemaVersion",
		"id",
		"name",
		"jurisdiction",
		"sector",
		"packs",
		"obligations",
		"decisionRights",
		"calibration",
		"ontology",
		"journeys",
		"personas",
		"glossary"
	]
}
