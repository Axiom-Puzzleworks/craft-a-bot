{
	"$id": "https://craftabot.dev/schemas/corpus.schema.json",
	"title": "Craft A Bot corpus (labelled rows as content)",
	"description": "Labelled rows a reader is scored on: each row’s state, tags and labels from closed sets with their guides, the question set it was written against, the annotators with their agreement, whether it was held out, the readers that have seen it, and a digest over the labels and rows frozen before any of that (105-CORPORA.md §3).",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"minLength": 1
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"version": {
			"type": "string",
			"minLength": 1
		},
		"stateKind": {
			"type": "string",
			"minLength": 1
		},
		"guide": {
			"type": "string",
			"minLength": 1
		},
		"labels": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"options": {
						"minItems": 2,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"guide": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"options",
					"guide"
				]
			}
		},
		"rows": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"state": {},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"labels": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": "string"
						}
					},
					"contested": {
						"type": "object",
						"properties": {
							"reason": {
								"type": "string",
								"minLength": 1
							},
							"alternatives": {
								"type": "object",
								"propertyNames": {
									"type": "string"
								},
								"additionalProperties": {
									"type": "string"
								}
							}
						},
						"required": [
							"reason",
							"alternatives"
						]
					}
				},
				"required": [
					"id",
					"state",
					"tags",
					"labels"
				]
			}
		},
		"questions": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"digest": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": [
				"id",
				"digest"
			]
		},
		"annotators": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"blind": {
						"type": "boolean"
					},
					"primary": {
						"type": "boolean",
						"const": true
					},
					"kappa": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": "number"
						}
					},
					"note": {
						"type": "string"
					}
				},
				"required": [
					"id",
					"blind"
				]
			}
		},
		"heldOut": {
			"type": "boolean"
		},
		"seenBy": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"readerId": {
						"type": "string",
						"minLength": 1
					},
					"questions": {
						"type": "string",
						"minLength": 1
					},
					"on": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"readerId",
					"questions",
					"on"
				]
			}
		},
		"digest": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		}
	},
	"required": [
		"id",
		"name",
		"version",
		"stateKind",
		"guide",
		"labels",
		"rows",
		"annotators",
		"heldOut",
		"seenBy",
		"digest"
	]
}
