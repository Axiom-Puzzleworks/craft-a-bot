{
	"$id": "https://craftabot.dev/schemas/reader.schema.json",
	"title": "Craft A Bot reader exchange (typed questions and a response)",
	"description": "Typed questions — a choice over keyed options, a noul, a score over ordered levels — and a reader’s response: who answered, by what method, and one answer per question with its distribution and confidence, rounded to six places (104-READERS.md §3).",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"questions": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"oneOf": [
					{
						"type": "object",
						"properties": {
							"type": {
								"type": "string",
								"const": "choice"
							},
							"instructions": {},
							"criteria": {
								"type": "object",
								"propertyNames": {
									"type": "string"
								},
								"additionalProperties": {}
							}
						},
						"required": [
							"type",
							"instructions",
							"criteria"
						]
					},
					{
						"type": "object",
						"properties": {
							"type": {
								"type": "string",
								"const": "noul"
							},
							"instructions": {},
							"criteria": {
								"type": "object",
								"properties": {
									"true": {},
									"false": {}
								}
							}
						},
						"required": [
							"type",
							"instructions"
						]
					},
					{
						"type": "object",
						"properties": {
							"type": {
								"type": "string",
								"const": "score"
							},
							"instructions": {},
							"criteria": {
								"minItems": 2,
								"maxItems": 10,
								"type": "array",
								"items": {}
							}
						},
						"required": [
							"type",
							"instructions",
							"criteria"
						]
					}
				]
			}
		},
		"response": {
			"type": "object",
			"properties": {
				"model": {
					"type": "string",
					"minLength": 1
				},
				"method": {
					"type": "string",
					"enum": [
						"rule",
						"hosted",
						"constrained",
						"logprobs",
						"argmax",
						"human"
					]
				},
				"answers": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"oneOf": [
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "choice"
									},
									"choice": {
										"type": "string"
									},
									"probabilities": {
										"type": "object",
										"propertyNames": {
											"type": "string"
										},
										"additionalProperties": {
											"type": "number",
											"minimum": 0,
											"maximum": 1
										}
									},
									"confidence": {
										"anyOf": [
											{
												"type": "number",
												"minimum": 0,
												"maximum": 1
											},
											{
												"type": "null"
											}
										]
									}
								},
								"required": [
									"type",
									"choice",
									"probabilities",
									"confidence"
								]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "noul"
									},
									"noul": {
										"type": "number",
										"minimum": 0,
										"maximum": 1
									}
								},
								"required": [
									"type",
									"noul"
								]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "score"
									},
									"score": {
										"type": "integer",
										"minimum": 0,
										"maximum": 9007199254740991
									},
									"probabilities": {
										"type": "array",
										"items": {
											"type": "number",
											"minimum": 0,
											"maximum": 1
										}
									},
									"confidence": {
										"anyOf": [
											{
												"type": "number",
												"minimum": 0,
												"maximum": 1
											},
											{
												"type": "null"
											}
										]
									}
								},
								"required": [
									"type",
									"score",
									"probabilities",
									"confidence"
								]
							}
						]
					}
				}
			},
			"required": [
				"model",
				"method",
				"answers"
			]
		}
	},
	"required": [
		"questions",
		"response"
	]
}
